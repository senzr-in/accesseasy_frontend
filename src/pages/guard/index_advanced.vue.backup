<template>
  <div class="h-full flex flex-col gap-6 overflow-hidden animate-in fade-in slide-in-from-bottom-4 duration-700 pb-6">
    <!-- Header/Tab Bar -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-200 dark:border-zinc-800 pb-4">
      <div class="flex gap-2 p-1 bg-slate-100/50 dark:bg-zinc-900/50 rounded-xl border border-slate-200/50 dark:border-zinc-800/50 p-1 w-full sm:w-auto overflow-x-auto custom-scrollbar">
        <button
          v-for="tab in tabs"
          :key="tab.id"
          class="flex items-center gap-2 px-4 py-2 rounded-lg text-xs font-bold uppercase tracking-widest transition-all whitespace-nowrap shrink-0"
          :class="[
            activeTab === tab.id
              ? 'bg-white dark:bg-indigo-500/20 text-indigo-600 dark:text-indigo-300 shadow-sm border border-slate-200 dark:border-indigo-500/30'
              : 'text-slate-500 hover:text-slate-700 dark:text-zinc-400 dark:hover:text-zinc-200 hover:bg-slate-200/50 dark:hover:bg-zinc-800/50'
          ]"
          @click="activeTab = tab.id"
        >
          <component :is="tab.icon" class="w-4 h-4" />
          {{ tab.name }}
        </button>
      </div>
    </div>

    <!-- Active Tab Content -->
    <div class="flex-1 min-h-0 overflow-hidden">
      <component :is="activeTabComponent" />
    </div>
  </div>
</template>

<script setup>
import { ref, computed } from 'vue';
import { ShieldCheck, Activity, Map } from 'lucide-vue-next';

// Import Tabs
import SOCTab from './tabs/SOCTab.vue';
import TeamTab from './tabs/TeamTab.vue';
import GateLogTab from './tabs/GateLogTab.vue';
import PatrolsTab from './tabs/PatrolsTab.vue';

const tabs = [
  { id: 'dashboard', name: 'Dashboard', icon: ShieldCheck, component: SOCTab },
  { id: 'patrols', name: 'Live Patrols', icon: Map, component: PatrolsTab },
  { id: 'visitors', name: 'Visitors', icon: Activity, component: GateLogTab },
  { id: 'team', name: 'Team', icon: ShieldCheck, component: TeamTab },
];

const activeTab = ref('dashboard');

const activeTabComponent = computed(() => {
  const tab = tabs.find(t => t.id === activeTab.value);
  return tab ? tab.component : TeamTab;
});
</script>
