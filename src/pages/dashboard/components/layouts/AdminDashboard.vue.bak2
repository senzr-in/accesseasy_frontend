      </div>

    </div>

  </div>
</template>

<script setup>
import { ref, computed, onMounted, onUnmounted } from 'vue';
import VueApexCharts from 'vue3-apexcharts';
import { useSOCState } from '@/composables/useSOCState';
import { useMQTT } from '@/composables/useMQTT';

const {
  kpiData,
  liveActivityFeed,
  todayOverview,
  alertsFeed,
  analyticsData,
  loadSOCData,
  startPolling,
  stopPolling,
  startMQTT,
  stopMQTT,
} = useSOCState();

const {
  mqttStatus,
  personEvents,
  lpEvents,
  personCounts,
  personSnapshots,
  lpSnapshots,
} = useMQTT();

// Register the component locally
const apexchart = VueApexCharts;

// KPI Cards mapped
const kpiCardsFormatted = computed(() => [
  { label: 'Employees Inside', value: kpiData.value.employeesInside, sub: `↑ ${kpiData.value.employeesTrend}% vs yesterday`, icon: '👤', iconBg: 'bg-blue-500/10 text-blue-500 border border-blue-500/20' },
  { label: 'Vehicles Inside', value: kpiData.value.vehiclesInside, sub: `↑ ${kpiData.value.vehiclesTrend}% vs yesterday`, icon: '🚗', iconBg: 'bg-green-500/10 text-green-500 border border-green-500/20' },
  { label: 'Unknown Persons', value: kpiData.value.unknownPersons, sub: 'Flagged for review', icon: '❓', iconBg: 'bg-yellow-500/10 text-yellow-500 border border-yellow-500/20' },
  { label: 'Offline Devices', value: kpiData.value.offlineDevices, sub: 'Needs attention', icon: '🔌', iconBg: 'bg-red-500/10 text-red-500 border border-red-500/20' },
  { label: 'Critical Alerts', value: kpiData.value.criticalAlerts, sub: 'Active incidents', icon: '⚠️', iconBg: 'bg-red-500/10 text-red-500 border border-red-500/20' },
]);

const todayOverviewMapped = computed(() => [
  { label: 'Entries', value: todayOverview.value.entries || 0, trend: todayOverview.value.entriesTrend || 0 },
  { label: 'Exits', value: todayOverview.value.exits || 0, trend: todayOverview.value.exitsTrend || 0 },
  { label: 'Employees Inside', value: todayOverview.value.employeesInside || 0, trend: todayOverview.value.employeesInsideTrend || 0 },
  { label: 'Vehicles Inside', value: todayOverview.value.vehiclesInside || 0, trend: todayOverview.value.vehiclesInsideTrend || 0 },
]);

// ── Camera registry ─────────────────────────────────────────────────────────
// Static config — mqttId must match Frigate's camera name (e.g. 'laptop_cam')
// type: 'people' | 'vehicle' | 'both'  — used by the filter tabs
const CAMERA_CONFIG = [
  { id: 1, name: 'Main Gate',          mqttId: 'main_gate',        type: 'both',    fallbackUrl: 'https://images.unsplash.com/photo-1558002038-1055907df827?w=400&q=60' },
  { id: 2, name: 'Reception',          mqttId: 'reception',        type: 'people',  fallbackUrl: 'https://images.unsplash.com/photo-1497366216548-37526070297c?w=400&q=60' },
  { id: 3, name: 'Warehouse Entrance', mqttId: 'laptop_cam',       type: 'people',  fallbackUrl: null },
  { id: 4, name: 'Parking Area',       mqttId: 'parking_area',     type: 'vehicle', fallbackUrl: 'https://images.unsplash.com/photo-1506521781263-d8422e82f27a?w=400&q=60' },
];

// Filter tab state
const cameraFilter = ref('All');

// Reactive camera registry — merges static config with live MQTT state
const cameraRegistry = computed(() =>
  CAMERA_CONFIG.map(cfg => {
    const liveSnap    = personSnapshots.value[cfg.mqttId] ?? null;
    const count       = personCounts.value[cfg.mqttId]   ?? 0;
    const activeEvent = personEvents.value.find(e => e.camera === cfg.mqttId && e.active);
    const latestLp    = lpEvents.value.find(e => e.camera === cfg.mqttId && (e.imageUrl || e.hasSnapshot));
    const isLive      = !!(liveSnap || count > 0);
    const lastUpd     = activeEvent
      ? new Date(activeEvent.timestamp).toLocaleTimeString()
      : liveSnap
      ? new Date().toLocaleTimeString()
      : null;
    return {
      ...cfg,
      liveSnapshot:    liveSnap,
      personCount:     count,
      hasActivePerson: !!activeEvent,
      latestLp:        latestLp ?? null,
      isLive,
      lastUpdated:     lastUpd,
    };
  })
);

// Filter cameras by tab
const filteredCameras = computed(() => {
  if (cameraFilter.value === 'All')      return cameraRegistry.value;
  if (cameraFilter.value === 'People')   return cameraRegistry.value.filter(c => c.type === 'people' || c.type === 'both');
  if (cameraFilter.value === 'Vehicles') return cameraRegistry.value.filter(c => c.type === 'vehicle' || c.type === 'both');
  return cameraRegistry.value;
});

const quickActions = [
  { icon: '👤', label: 'Add Employee', href: '/dashboard/easy-access/employees' },
  { icon: '🚪', label: 'Manage Doors', href: '/dashboard/access-control/doors' },
  { icon: '🛡️', label: 'Patrol Status', href: '/dashboard/patrols' },
  { icon: '📷', label: 'Live Monitoring', href: '/dashboard/monitoring' },
  { icon: '📊', label: 'View Reports', href: '/dashboard/report-automation' },
];

// --- ApexCharts Configuration ---

// 1. Entries vs Exits (Area Chart)
const entriesVsExitsSeries = computed(() => [
  { name: 'Entries', data: analyticsData.value.entriesVsExits?.entries || [10, 30, 20, 60, 40] },
  { name: 'Exits', data: analyticsData.value.entriesVsExits?.exits || [5, 20, 15, 45, 30] }
]);
const lineChartLabels = computed(() => analyticsData.value.entriesVsExits?.labels || ['12A', '6A', '12P', '6P', '12A']);
const entriesVsExitsOptions = {
  chart: { type: 'area', toolbar: { show: false }, background: 'transparent', sparkline: { enabled: true }, animations: { enabled: false } },
  stroke: { curve: 'smooth', width: 2 },
  colors: ['#3b82f6', '#a855f7'],
  fill: { type: 'gradient', gradient: { shadeIntensity: 1, opacityFrom: 0.4, opacityTo: 0.05, stops: [0, 100] } },
  tooltip: { theme: 'dark', y: { formatter: (val) => val } }
};

// 2. Peak Entry Hours (Bar Chart)
const peakHoursSeries = computed(() => [{ name: 'Volume', data: analyticsData.value.peakEntryHours?.data || [10, 40, 60, 30, 20, 10] }]);
const barChartLabels = computed(() => analyticsData.value.peakEntryHours?.labels || ['6A', '8A', '10A', '12P', '2P', '4P']);
const peakHoursOptions = {
  chart: { type: 'bar', toolbar: { show: false }, background: 'transparent', sparkline: { enabled: true }, animations: { enabled: false } },
  colors: ['#22c55e'],
  plotOptions: { bar: { borderRadius: 3, columnWidth: '60%' } },
  tooltip: { theme: 'dark' }
};

// 3. Security Events (Line Chart with markers)
const securityEventsSeries = computed(() => [{ name: 'Events', data: analyticsData.value.securityEventsTrend?.data || [2, 5, 3, 8, 4, 1, 0] }]);
const areaChartLabels = computed(() => analyticsData.value.securityEventsTrend?.labels || ['M', 'T', 'W', 'T', 'F', 'S', 'S']);
const securityEventsOptions = {
  chart: { type: 'line', toolbar: { show: false }, background: 'transparent', sparkline: { enabled: true }, animations: { enabled: false } },
  stroke: { curve: 'straight', width: 2 },
  colors: ['#f97316'],
  markers: { size: 4, colors: ['#f97316'], strokeColors: '#151c2c', strokeWidth: 2, hover: { size: 6 } },
  tooltip: { theme: 'dark' }
};

onMounted(() => {
  loadSOCData();
  startPolling(10000);
  startMQTT();
});

onUnmounted(() => {
  stopPolling();
  stopMQTT();
});
</script>
