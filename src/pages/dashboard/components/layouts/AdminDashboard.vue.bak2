        </div>
      </div>

      <!-- License Plate Feed -->
      <div class="bg-[#151c2c] border border-white/5 rounded-2xl flex flex-col shadow-lg overflow-hidden h-[360px]">
        <div class="px-5 py-4 border-b border-white/5 flex items-center justify-between shrink-0">
          <div class="flex items-center gap-2">
