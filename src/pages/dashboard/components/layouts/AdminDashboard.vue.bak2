    <!-- ── MQTT LIVE DETECTIONS ROW ── -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-5 shrink-0">

      <!-- Person Detection Feed -->
      <div class="bg-[#151c2c] border border-white/5 rounded-2xl flex flex-col shadow-lg overflow-hidden h-[360px]">
        <div class="px-5 py-4 border-b border-white/5 flex items-center justify-between shrink-0">
          <div class="flex items-center gap-2">
            <span class="text-sm font-semibold text-white">👤 Person Detections</span>
            <span class="bg-blue-500/15 text-blue-400 border border-blue-500/20 rounded-full px-2 py-0.5 text-[10px] font-bold">{{ personEvents.length }}</span>
          </div>
          <span class="text-[10px] uppercase tracking-wider text-slate-500 font-bold">Live · MQTT</span>
        </div>
        <div class="flex-1 overflow-y-auto divide-y divide-white/5">
