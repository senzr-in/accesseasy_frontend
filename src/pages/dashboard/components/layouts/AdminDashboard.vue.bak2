              <span v-else>👤</span>
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center justify-between gap-2">
                <span
                  :class="[
                    'text-[10px] font-bold uppercase tracking-wider px-1.5 py-0.5 rounded',
                    ev.type === 'new' ? 'bg-green-500/15 text-green-400'
                    : ev.type === 'end' ? 'bg-slate-500/15 text-slate-400'
                    : 'bg-blue-500/15 text-blue-400'
                  ]"
                >{{ ev.type }}</span>
                <span class="text-[10px] text-slate-500 font-medium whitespace-nowrap">{{ new Date(ev.timestamp).toLocaleTimeString() }}</span>
              </div>
              <p class="text-[13px] font-semibold text-white m-0 mt-1 truncate">{{ ev.camera }}</p>
              <div class="flex items-center gap-2 mt-0.5">
                <span class="text-[11px] text-slate-400">Score: <span class="text-white font-semibold">{{ (ev.score * 100).toFixed(0) }}%</span></span>
                <span v-if="ev.active" class="text-[10px] text-green-400 font-bold">● Active</span>
                <span v-else class="text-[10px] text-slate-500">● Ended</span>
              </div>
            </div>
          </div>
          <div v-if="!personEvents.length" class="flex flex-col items-center justify-center h-full gap-2 text-slate-500">
