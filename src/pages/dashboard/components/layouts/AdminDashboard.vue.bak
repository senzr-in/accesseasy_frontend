<template>
  <div class="min-h-screen bg-[#0b0f19] text-slate-50 p-6 font-sans overflow-y-auto">
    <!-- Top Header -->
    <div class="flex items-center justify-between mb-8">
      <div>
        <h1 class="text-[28px] font-semibold text-white m-0 tracking-wide">Dashboard</h1>
        <p class="text-[14px] text-slate-400 mt-1 mb-0">Real-time overview of your facility</p>
      </div>
      <div class="flex items-center gap-4">
        <span class="inline-flex items-center gap-1.5 bg-green-500/10 border border-green-500/25 rounded-full px-3.5 py-1 text-[11px] font-bold text-green-500 tracking-wide">
          <span class="w-1.5 h-1.5 rounded-full bg-green-500 inline-block animate-pulse"></span>
          LIVE
        </span>
        <button @click="loadSOCData" class="bg-white/5 border border-white/10 rounded-lg px-3.5 py-1.5 text-slate-300 text-xs font-semibold cursor-pointer hover:bg-white/10 transition-colors">↺ Refresh</button>
      </div>
    </div>

    <!-- KPI CARDS -->
    <div class="grid grid-cols-1 md:grid-cols-5 gap-5 mb-6">
      <div v-for="(card, i) in kpiCardsFormatted" :key="card.label" class="bg-[#151c2c] border border-white/5 rounded-2xl p-5 flex flex-col justify-between shadow-lg">
        <div class="flex items-start gap-4">
          <div :class="`w-12 h-12 rounded-full flex items-center justify-center shrink-0 ${card.iconBg}`">
            <span class="text-xl" v-html="card.icon"></span>
          </div>
          <div>
            <p class="text-[13px] font-medium text-slate-400 m-0 mb-1.5">{{ card.label }}</p>
            <h3 class="text-[32px] font-bold text-white m-0 leading-none tracking-tight">{{ card.value }}</h3>
            <div class="mt-3">
              <span class="text-[12px] font-medium text-slate-400">{{ card.sub }}</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- MAIN 3-COLUMN GRID -->
    <div class="grid grid-cols-1 xl:grid-cols-12 gap-5 mb-6">
      
      <!-- LEFT: Live Activity Feed -->
      <div class="xl:col-span-3 bg-[#151c2c] border border-white/5 rounded-2xl flex flex-col shadow-lg overflow-hidden">
        <div class="px-5 py-4 border-b border-white/5 flex items-center justify-between">
          <span class="text-[15px] font-semibold text-white">Live Activity</span>
        </div>
        <div class="p-4 flex-1 overflow-y-auto">
          <div v-for="event in liveActivityFeed" :key="event.id" class="flex gap-4 mb-5 last:mb-0">
            <div class="w-11 h-11 rounded-full overflow-hidden shrink-0 bg-slate-800 border border-white/10 flex items-center justify-center text-lg">
              <span v-if="event.status === 'authorized'">✅</span>
              <span v-else>⚠️</span>
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center justify-between">
                <span :class="`text-[13px] font-semibold truncate ${event.status === 'authorized' ? 'text-green-500' : 'text-red-500'}`">{{ event.type }}</span>
                <span class="text-[12px] text-slate-400 flex items-center gap-1.5 font-medium">
                  {{ event.time }}
                </span>
              </div>
              <p class="text-[14px] font-medium text-white m-0 mt-0.5 truncate">{{ event.name }}</p>
              <p class="text-[12px] text-slate-400 m-0 mt-1 truncate">{{ event.gate }}</p>
            </div>
          </div>
          <p v-if="!liveActivityFeed.length" class="text-xs text-slate-500 text-center p-4">No activity yet</p>
        </div>
      </div>

      <!-- CENTER: Camera Grid -->
      <div class="xl:col-span-6 bg-[#151c2c] border border-white/5 rounded-2xl flex flex-col shadow-lg overflow-hidden">
        <div class="px-5 py-4 border-b border-white/5 flex items-center justify-between">
          <span class="text-[15px] font-semibold text-white">Live Monitoring</span>
          <div class="flex gap-5 text-[13px] font-medium">
            <span class="text-blue-500 border-b-2 border-blue-500 pb-4 -mb-4 cursor-pointer">All</span>
            <span class="text-slate-400 hover:text-white cursor-pointer transition-colors">People</span>
            <span class="text-slate-400 hover:text-white cursor-pointer transition-colors">Vehicles</span>
            <span class="text-slate-400 hover:text-white cursor-pointer transition-colors">Doors</span>
          </div>
        </div>
        <div class="p-4 grid grid-cols-2 gap-4 flex-1">
          <div v-for="cam in mockCameras" :key="cam.id" class="relative rounded-xl overflow-hidden bg-black group border border-white/10 shadow-inner min-h-[160px]">
            <img v-if="cam.snapshotUrl" :src="cam.snapshotUrl" class="w-full h-full object-cover opacity-90 group-hover:opacity-100 transition-opacity" />
            <div v-else class="w-full h-full flex items-center justify-center bg-zinc-900 text-3xl">📷</div>
            <div class="absolute top-3 left-3 bg-black/60 backdrop-blur-md px-2.5 py-1 rounded-md text-[12px] font-medium text-white border border-white/10">
              {{ cam.name }}
            </div>
            <div :class="`absolute top-3 right-3 px-2.5 py-1 rounded-md text-[11px] font-bold tracking-wide ${cam.status === 'online' ? 'bg-green-500/20 text-green-400 border border-green-500/30' : 'bg-red-500/20 text-red-400 border border-red-500/30'}`">
              {{ cam.status === 'online' ? 'Live' : 'Offline' }}
            </div>
          </div>
        </div>
        <div class="py-3.5 text-center border-t border-white/5 text-[13px] font-medium text-slate-300 hover:text-white cursor-pointer transition-colors bg-white/[0.02]">
          Go to Live Monitoring &rarr;
        </div>
      </div>

      <!-- RIGHT: Today's Overview + Alerts -->
      <div class="xl:col-span-3 flex flex-col gap-5">
        <!-- Overview stats -->
        <div class="bg-[#151c2c] border border-white/5 rounded-2xl p-5 shadow-lg">
          <div class="flex justify-between items-center mb-5">
            <span class="text-[15px] font-semibold text-white">Today's Overview</span>
          </div>
          <div class="flex flex-col gap-5">
            <div v-for="(val, key) in todayOverview" :key="key" class="flex items-center justify-between border-b border-white/5 pb-2 last:border-0 last:pb-0">
              <span class="text-[13px] font-medium text-slate-300 capitalize">{{ String(key).replace(/([A-Z])/g, ' $1').trim() }}</span>
              <span class="text-[15px] font-bold text-white">{{ val }}</span>
            </div>
          </div>
        </div>
        <!-- Alerts -->
        <div class="bg-[#151c2c] border border-white/5 rounded-2xl flex-1 flex flex-col shadow-lg overflow-hidden">
          <div class="px-5 py-4 border-b border-white/5 flex justify-between items-center">
            <span class="text-[15px] font-semibold text-white">Alerts</span>
          </div>
          <div class="p-4 flex-1 overflow-y-auto">
             <div v-for="alert in alertsFeed" :key="alert.id" class="flex gap-3.5 items-start mb-5 last:mb-0">
               <div :class="`w-2 h-2 mt-1.5 rounded-full shrink-0 ${alert.priority === 'critical' ? 'bg-red-500' : alert.priority === 'warning' ? 'bg-orange-500' : 'bg-blue-500'}`"></div>
               <div class="flex-1 min-w-0">
                 <p class="text-[13px] font-semibold m-0 text-white truncate">{{ alert.title }}</p>
                 <p class="text-[12px] text-slate-400 m-0 mt-0.5 truncate">{{ alert.location }}</p>
               </div>
               <span class="text-[11px] text-slate-500 whitespace-nowrap">{{ alert.time }}</span>
             </div>
             <p v-if="!alertsFeed.length" class="text-xs text-slate-500 text-center p-3">No active alerts</p>
          </div>
        </div>
      </div>

    </div>

    <!-- ── ANALYTICS ROW ── -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-8">
      <div v-for="(chart, idx) in analyticsCharts" :key="chart.title" class="bg-[#151c2c] border border-white/5 rounded-2xl p-5 shadow-lg">
        <div class="flex justify-between items-center mb-6">
          <span class="text-[15px] font-semibold text-white">{{ chart.title }}</span>
        </div>
        <!-- Proper Responsive CSS Bar Chart -->
        <div class="h-[120px] w-full flex items-end justify-between gap-1.5 relative px-1">
          <!-- Background Grid Lines -->
          <div class="absolute inset-0 flex flex-col justify-between pointer-events-none pb-6">
            <div class="border-b border-white/5 w-full flex-1"></div>
            <div class="border-b border-white/5 w-full flex-1"></div>
            <div class="border-b border-white/5 w-full flex-1"></div>
            <div class="border-b border-white/5 w-full flex-1"></div>
          </div>
          
          <!-- Bars -->
          <div v-for="(val, i) in chart.data" :key="i" class="w-full flex-1 flex items-end relative group h-full pb-6 z-10" :title="String(val)">
            <div class="w-full rounded-t-sm transition-all duration-300 opacity-90 group-hover:opacity-100" 
                 :style="`background:${chart.color}; height:${Math.max(4, (val / Math.max(...chart.data)) * 100)}%;`"></div>
            <!-- Tooltip -->
            <div class="absolute -top-8 left-1/2 transform -translate-x-1/2 bg-black text-white text-[10px] px-2 py-1 rounded opacity-0 group-hover:opacity-100 pointer-events-none">{{val}}</div>
          </div>
        </div>
        <!-- X Axis Labels -->
        <div class="flex justify-between text-[11px] font-medium text-slate-500 mt-2 px-1">
          <span v-for="(label, i) in chart.labels" :key="i" :class="{'hidden sm:block': i > 0 && i < chart.labels.length - 1 && chart.labels.length > 6}">{{ label }}</span>
        </div>
      </div>
    </div>

    <!-- QUICK ACTIONS -->
    <div class="bg-[#151c2c] border border-white/5 rounded-2xl p-5 shadow-lg mb-6">
      <p class="text-[14px] font-semibold text-white m-0 mb-4">Quick Actions</p>
      <div class="flex flex-wrap gap-4">
        <button
          v-for="action in quickActions"
          :key="action.label"
          @click="$router.push(action.href)"
          class="bg-white/5 hover:bg-white/10 border border-white/10 rounded-xl px-5 py-3.5 text-slate-300 hover:text-white text-[13px] font-medium cursor-pointer flex items-center gap-3.5 transition-all shadow-sm"
        >
          <span class="text-lg">{{ action.icon }}</span>
          {{ action.label }}
        </button>
      </div>
    </div>
  </div>
</template>

<script setup>
import { ref, computed, onMounted, onUnmounted } from 'vue';
import { useSOCState } from '@/composables/useSOCState';

const {
  kpiData,
  liveActivityFeed,
  todayOverview,
  alertsFeed,
  analyticsData,
  loadSOCData,
  startPolling,
  stopPolling
} = useSOCState();

// KPI Cards mapped with custom icons/colors for the dark theme
const kpiCardsFormatted = computed(() => [
  { 
    label: 'Employees Inside', 
    value: kpiData.value.employeesInside, 
    sub: `↑ ${kpiData.value.employeesTrend}% vs yesterday`,
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>',
    iconBg: 'bg-blue-500/10 text-blue-500'
  },
  { 
    label: 'Vehicles Inside', 
    value: kpiData.value.vehiclesInside, 
    sub: `↑ ${kpiData.value.vehiclesTrend}% vs yesterday`,
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2"/><circle cx="7" cy="17" r="2"/><path d="M9 17h6"/><circle cx="17" cy="17" r="2"/></svg>',
    iconBg: 'bg-green-500/10 text-green-500'
  },
  { 
    label: 'Unknown Persons', 
    value: kpiData.value.unknownPersons, 
    sub: 'Flagged for review',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M3 7V5a2 2 0 0 1 2-2h2"/><path d="M17 3h2a2 2 0 0 1 2 2v2"/><path d="M21 17v2a2 2 0 0 1-2 2h-2"/><path d="M7 21H5a2 2 0 0 1-2-2v-2"/></svg>',
    iconBg: 'bg-yellow-500/10 text-yellow-500'
  },
  { 
    label: 'Offline Devices', 
    value: kpiData.value.offlineDevices, 
    sub: 'Needs attention',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="14" height="20" x="5" y="2" rx="2" ry="2"/><path d="M12 18h.01"/></svg>',
    iconBg: 'bg-red-500/10 text-red-500'
  },
  { 
    label: 'Critical Alerts', 
    value: kpiData.value.criticalAlerts, 
    sub: 'Active incidents',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m12 14 4-4"/><path d="M3.3 7H6h.5a2 2 0 0 1 1.98 1.67l.74 5.22a2 2 0 0 0 1.98 1.67H14v5"/><path d="m8 16-3 3-1-1 3-3"/><path d="M21 12a9 9 0 1 0-9 9"/></svg>',
    iconBg: 'bg-red-500/10 text-red-500'
  },
]);

const mockCameras = [
  { id: 1, name: 'Main Gate',           status: 'online',  snapshotUrl: 'https://images.unsplash.com/photo-1558002038-1055907df827?w=400&q=60' },
  { id: 2, name: 'Reception',           status: 'online',  snapshotUrl: 'https://images.unsplash.com/photo-1497366216548-37526070297c?w=400&q=60' },
  { id: 3, name: 'Warehouse Entrance',  status: 'offline', snapshotUrl: null },
  { id: 4, name: 'Parking Area',        status: 'online',  snapshotUrl: 'https://images.unsplash.com/photo-1506521781263-d8422e82f27a?w=400&q=60' },
];

const analyticsCharts = computed(() => [
  {
    title: 'Entries vs Exits',
    data: analyticsData.value.entriesVsExits?.entries || [10, 20, 50, 80, 20],
    labels: analyticsData.value.entriesVsExits?.labels || ['12AM', '6AM', '12PM', '6PM', '12AM'],
    color: '#3b82f6',
  },
  {
    title: 'Peak Entry Hours',
    data: analyticsData.value.peakEntryHours?.data || [10, 80, 40, 20, 30, 10],
    labels: analyticsData.value.peakEntryHours?.labels || ['6AM', '8AM', '10AM', '12PM', '2PM', '4PM'],
    color: '#22c55e',
  },
  {
    title: 'Security Events',
    data: analyticsData.value.securityEventsTrend?.data || [5, 2, 8, 3, 1, 0, 1],
    labels: analyticsData.value.securityEventsTrend?.labels || ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
    color: '#f97316',
  },
]);

const quickActions = [
  { icon: '👤', label: 'Add Employee',    href: '/dashboard/easy-access/employees' },
  { icon: '🚪', label: 'Manage Doors',    href: '/dashboard/access-control/doors' },
  { icon: '📋', label: 'View Logs',       href: '/dashboard/settings/logs' },
  { icon: '🛡️', label: 'Patrol Status',   href: '/dashboard/patrols' },
  { icon: '📷', label: 'Live Monitoring', href: '/dashboard/monitoring' },
  { icon: '📊', label: 'Reports',         href: '/dashboard/report-automation' },
];

onMounted(() => {
  loadSOCData();
  startPolling(10000);
});

onUnmounted(() => {
  stopPolling();
});
</script>
