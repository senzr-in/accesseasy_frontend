<template>
  <div class="h-full flex flex-col gap-4 overflow-hidden animate-in">
    <!-- Teleported Page Header -->
    <Teleport to="#header-title-slot">
      <div class="animate-in fade-in slide-in-from-left-2 duration-300">
        <h1 class="text-lg font-black text-slate-900 dark:text-white tracking-tight">
          {{ pageTitle }}
        </h1>
        <p class="text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest mt-0.5 truncate max-w-xl">
          {{ pageSubtitle }}
        </p>
      </div>
    </Teleport>

    <!-- Portal link copied toast -->
    <transition name="fade">
      <div
        v-if="linkCopied"
        class="shrink-0 flex items-center gap-2 px-4 py-2.5 bg-emerald-50 border border-emerald-200 rounded-lg text-sm font-medium text-emerald-700"
      >
        <CheckCircle class="w-4 h-4" />
        Portal link copied to clipboard! Share it with visitors to self-register.
      </div>
    </transition>

    <!-- Navigation Tabs -->

    <!-- Analytics Tab -->
    <div
      v-if="activeTab === 'analytics'"
      class="flex flex-col gap-4 animate-in"
    >
      <!-- Quick Actions & Stats (Single Row Compact View) -->
      <div class="flex flex-nowrap items-center gap-3 overflow-x-auto pb-2 custom-scrollbar">
        <!-- Action: Register -->
        <button 
          class="ae-card p-3 ae-card-hover flex items-center gap-3 text-left group bg-indigo-50/50 dark:bg-indigo-900/10 border-indigo-100 dark:border-indigo-900/30 shrink-0"
          @click="showAddModal = true"
        >
          <div class="w-8 h-8 rounded-lg bg-indigo-100 dark:bg-indigo-900/50 flex items-center justify-center text-indigo-600 dark:text-indigo-400 group-hover:scale-110 transition-transform">
            <UserPlus class="w-4 h-4" />
          </div>
          <div>
            <h3 class="font-bold text-xs text-slate-900 dark:text-slate-100 whitespace-nowrap">Register Walk-in</h3>
          </div>
        </button>

        <!-- Action: Scan QR -->
        <button 
          class="ae-card p-3 ae-card-hover flex items-center gap-3 text-left group shrink-0"
          @click="showQrModal = true"
        >
          <div class="w-8 h-8 rounded-lg bg-amber-50 dark:bg-amber-900/20 flex items-center justify-center text-amber-600 group-hover:scale-110 transition-transform">
            <QrCode class="w-4 h-4" />
          </div>
          <div>
            <h3 class="font-bold text-xs text-slate-900 dark:text-slate-100 whitespace-nowrap">Scan QR Code</h3>
          </div>
        </button>

        <!-- Action: Export -->
        <button 
          class="ae-card p-3 ae-card-hover flex items-center gap-3 text-left group shrink-0"
          @click="exportVisitorsExcel()"
        >
          <div class="w-8 h-8 rounded-lg bg-emerald-50 dark:bg-emerald-900/20 flex items-center justify-center text-emerald-600 group-hover:scale-110 transition-transform">
            <FileDown class="w-4 h-4" />
          </div>
          <div>
            <h3 class="font-bold text-xs text-slate-900 dark:text-slate-100 whitespace-nowrap">Export</h3>
          </div>
        </button>

        <div class="w-px h-8 bg-slate-200 dark:bg-slate-700 shrink-0 mx-1"></div>

        <!-- Stat: Expected -->
        <div class="ae-card p-3 flex items-center gap-4 shrink-0 border-l-4 border-l-slate-800 dark:border-l-slate-400 min-w-[120px]">
          <div>
            <p class="text-[9px] font-black uppercase tracking-widest text-slate-400 mb-0.5 whitespace-nowrap">Expected</p>
            <p class="text-xl font-bold leading-none text-slate-900 dark:text-slate-100">{{ analyticsStats.today }}</p>
          </div>
        </div>

        <!-- Stat: On-site -->
        <div class="ae-card p-3 flex items-center gap-4 shrink-0 border-l-4 border-l-emerald-500 min-w-[120px]">
          <div>
            <p class="text-[9px] font-black uppercase tracking-widest text-slate-400 mb-0.5 whitespace-nowrap">On-site</p>
            <p class="text-xl font-bold leading-none text-emerald-600 dark:text-emerald-400">{{ analyticsStats.checkedIn }}</p>
          </div>
        </div>

        <!-- Stat: Checked Out -->
        <div class="ae-card p-3 flex items-center gap-4 shrink-0 border-l-4 border-l-amber-500 min-w-[120px]">
          <div>
            <p class="text-[9px] font-black uppercase tracking-widest text-slate-400 mb-0.5 whitespace-nowrap">Completed</p>
            <p class="text-xl font-bold leading-none text-amber-600 dark:text-amber-400">{{ analyticsStats.checkedOut }}</p>
          </div>
        </div>

        <!-- Stat: Blocked -->
        <div class="ae-card p-3 flex items-center gap-4 shrink-0 border-l-4 border-l-rose-500 min-w-[120px]">
          <div>
            <p class="text-[9px] font-black uppercase tracking-widest text-slate-400 mb-0.5 whitespace-nowrap">Blocked</p>
            <p class="text-xl font-bold leading-none text-rose-600 dark:text-rose-400">{{ analyticsStats.blocked }}</p>
          </div>
        </div>
      </div>

    </div>




    <!-- Toolbar: Search, Filter, Sort, Export -->
    <div 
      v-if="activeTab === 'analytics' || activeTab === 'pending'"
      class="relative z-20 flex flex-wrap items-center gap-3 shrink-0 animate-in"
    >
      <div class="relative flex-1 max-w-sm">
        <Search class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 w-4 h-4" />
        <input
          v-model="searchQuery"
          type="search"
          placeholder="Search by name, email, mobile..."
          class="ae-input"
          style="padding-left: 2.25rem;"
          @input="debouncedSearch"
        >
      </div>

      <!-- Status Filter -->
      <div v-if="activeTab === 'analytics'" class="flex items-center bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg p-1 gap-1">
        <button
          v-for="f in filters"
          :key="f.value"
          class="px-3 py-1 rounded-md text-xs font-semibold transition-all"
          :class="statusFilter === f.value
            ? 'bg-indigo-600 text-white shadow-sm'
            : 'text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:text-slate-200'"
          @click="statusFilter = f.value"
        >
          {{ f.label }}
        </button>
      </div>

      <!-- Date Filter -->
      <div class="flex items-center">
        <select v-model="dateFilter" class="ae-input text-xs py-1.5 h-auto min-w-[130px] bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg outline-none cursor-pointer">
          <option value="all">Date: All Time</option>
          <option value="today">Date: Today</option>
          <option value="this_week">Date: Last 7 Days</option>
          <option value="this_month">Date: Last 30 Days</option>
        </select>
      </div>

      <!-- Sort -->
      <div class="flex items-center">
        <select v-model="sortOrder" class="ae-input text-xs py-1.5 h-auto min-w-[140px] bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg outline-none cursor-pointer">
          <option value="newest">Sort: Newest First</option>
          <option value="oldest">Sort: Oldest First</option>
          <option value="nameAsc">Sort: Name (A-Z)</option>
          <option value="nameDesc">Sort: Name (Z-A)</option>
        </select>
      </div>
      
      <!-- Layout Switcher (Pending Only) -->
      <div v-if="activeTab === 'pending'" class="flex items-center bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg p-1 gap-1">
         <button class="px-2 py-1.5 rounded-md transition-all" :class="pendingLayout === 'grid' ? 'bg-indigo-100 text-indigo-700 dark:bg-indigo-900/30 dark:text-indigo-400 shadow-sm' : 'text-slate-400 hover:text-slate-600 dark:hover:text-slate-300'" @click="pendingLayout = 'grid'" title="Grid View">
           <LayoutGrid class="w-4 h-4" />
         </button>
         <button class="px-2 py-1.5 rounded-md transition-all" :class="pendingLayout === 'list' ? 'bg-indigo-100 text-indigo-700 dark:bg-indigo-900/30 dark:text-indigo-400 shadow-sm' : 'text-slate-400 hover:text-slate-600 dark:hover:text-slate-300'" @click="pendingLayout = 'list'" title="List View">
           <List class="w-4 h-4" />
         </button>
      </div>

      <!-- Export -->
      <div v-if="activeTab === 'analytics'" class="relative">
        <button class="btn-secondary text-xs" @click.stop="showExportMenu = !showExportMenu">
          <FileDown class="w-3.5 h-3.5" />
          Export
        </button>
        <!-- Backdrop to close on outside click -->
        <div
          v-if="showExportMenu"
          class="fixed inset-0 z-40"
          @click="showExportMenu = false"
        />
        <div
          v-if="showExportMenu"
          class="absolute right-0 mt-1 w-40 ae-card shadow-lg py-1 z-50"
          @click.stop
        >
          <button
            class="w-full text-left px-4 py-2.5 text-xs font-semibold text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors flex items-center gap-2"
            @click="exportVisitorsExcel(); showExportMenu = false"
          >
            <FileDown class="w-3.5 h-3.5 text-emerald-500" />
            Export Excel
          </button>
          <button
            class="w-full text-left px-4 py-2.5 text-xs font-semibold text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors flex items-center gap-2"
            @click="exportVisitorsCSV(); showExportMenu = false"
          >
            <FileDown class="w-3.5 h-3.5 text-blue-500" />
            Export CSV
          </button>
        </div>
      </div>
    </div>


    <!-- Visitor Records Table -->
    <div 
      v-if="activeTab === 'analytics'"
      class="ae-card overflow-hidden flex flex-col flex-1 min-h-0 animate-in mt-2"
    >
      <!-- Table Header -->
      <div class="grid grid-cols-12 px-5 py-3 border-b border-slate-100 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/50 text-[10px] font-semibold uppercase tracking-wider text-slate-400 shrink-0">
        <div class="col-span-5">
          Visitor
        </div>
        <div class="col-span-3 hidden md:block">
          Contact
        </div>
        <div class="col-span-2 hidden lg:block">
          Validity
        </div>
        <div class="col-span-2 text-center">
          Status
        </div>
      </div>

      <!-- Body -->
      <div class="overflow-y-auto flex-1 custom-scrollbar">
        <!-- Loading -->
        <div
          v-if="loading"
          class="flex flex-col gap-3 p-4"
        >
          <div
            v-for="i in 5"
            :key="i"
            class="h-14 bg-slate-100 dark:bg-slate-950 animate-pulse rounded-lg"
          />
        </div>

        <!-- Empty -->
        <div
          v-else-if="filteredItems.length === 0"
          class="py-20 text-center"
        >
          <Users class="w-10 h-10 text-slate-300 mx-auto mb-3" />
          <p class="text-sm font-semibold text-slate-500 dark:text-slate-400">
            No visitors found
          </p>
          <p class="text-xs text-slate-400 mt-1">
            Try adjusting your search or filters
          </p>
          <button
            v-if="searchQuery"
            class="mt-3 text-xs font-medium text-indigo-600 hover:underline"
            @click="searchQuery = ''; loadVisitors()"
          >
            Clear search
          </button>
        </div>

        <!-- Rows -->
        <div
          v-for="visitor in filteredItems"
          :key="visitor.id"
          class="grid grid-cols-12 px-5 py-3.5 border-b border-slate-50 hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors group cursor-pointer items-center"
          @click="viewVisitorCard(visitor)"
        >
          <!-- Avatar + Name -->
          <div class="col-span-5 flex items-center gap-4">
            <div class="p-1 rounded-[1.25rem] bg-slate-100 dark:bg-slate-950/80 border border-slate-200 dark:border-slate-800/60 shadow-sm shrink-0">
              <div class="w-14 h-14 rounded-2xl overflow-hidden bg-indigo-100 flex items-center justify-center text-xl font-black text-indigo-700">
                <img
                  v-if="visitor.photo"
                  :src="getPhotoUrl(visitor.photo)"
                  class="w-full h-full object-cover"
                >
                <span v-else>{{ visitor.personName?.charAt(0).toUpperCase() || '?' }}</span>
              </div>
            </div>
            <div class="min-w-0">
              <p class="text-base font-bold text-slate-900 dark:text-slate-100 truncate">
                {{ visitor.personName }}
              </p>
              <p class="text-sm text-slate-500 dark:text-slate-400 truncate">
                {{ visitor.personToMeet ? `→ ${visitor.personToMeet}` : visitor.company || '' }}
              </p>
            </div>
          </div>

          <!-- Contact -->
          <div class="col-span-3 hidden md:block">
            <p class="text-sm text-slate-700 dark:text-slate-200">
              {{ visitor.mobileNumber || '—' }}
            </p>
            <p class="text-xs text-slate-400 truncate">
              {{ visitor.email || '' }}
            </p>
          </div>

          <!-- Validity -->
          <div class="col-span-2 hidden lg:block">
            <p class="text-sm text-slate-700 dark:text-slate-200">
              {{ formatDate(visitor.startDate) }}
            </p>
            <p class="text-xs text-slate-400">
              {{ visitor.startTime?.slice(0, 5) || '' }} – {{ visitor.endTime?.slice(0, 5) || '' }}
            </p>
          </div>

          <!-- Status -->
          <div class="col-span-2 flex justify-center">
            <span
              class="badge"
              :class="getStatusClass(visitor.status)"
            >
              <span
                class="w-1.5 h-1.5 rounded-full"
                :class="getStatusDot(visitor.status)"
              />
              {{ getStatusLabel(visitor.status) }}
            </span>
          </div>

          <!-- Actions Removed -->
        </div>
      </div>

      <!-- Pagination -->
      <div class="flex items-center justify-between px-5 py-3 border-t border-slate-100 dark:border-slate-700 bg-white dark:bg-slate-900 shrink-0">
        <button
          class="btn-secondary text-xs py-1.5"
          :disabled="page <= 1 || loading"
          @click="page--"
        >
          ← Previous
        </button>
        <span class="text-xs text-slate-500 dark:text-slate-400">
          Page {{ page }} of {{ totalPages || 1 }} &nbsp;·&nbsp; {{ totalItems }} total
        </span>
        <button
          class="btn-secondary text-xs py-1.5"
          :disabled="page >= totalPages || loading"
          @click="page++"
        >
          Next →
        </button>
      </div>
    </div>

    <!-- Pending Approvals Grid View -->
    <div
      v-if="activeTab === 'pending'"
      class="flex-1 overflow-y-auto animate-in custom-scrollbar"
    >
      <!-- Loading State -->
      <div v-if="loading" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
        <div v-for="i in 6" :key="i" class="h-[280px] bg-slate-100 dark:bg-slate-800 rounded-2xl animate-pulse"></div>
      </div>
      
      <!-- Empty State -->
      <div v-else-if="filteredItems.length === 0" class="flex flex-col items-center justify-center h-full py-16 text-center bg-white/50 dark:bg-slate-900/50 rounded-2xl border border-dashed border-slate-200 dark:border-slate-800">
        <div class="w-20 h-20 bg-emerald-50 dark:bg-emerald-900/20 rounded-full flex items-center justify-center mx-auto mb-4 border border-emerald-100 dark:border-emerald-800">
          <CheckCircle class="w-10 h-10 text-emerald-500" />
        </div>
        <h3 class="text-xl font-bold text-slate-800 dark:text-slate-200">No Pending Approvals</h3>
        <p class="text-slate-500 dark:text-slate-400 mt-2 max-w-xs">All self-registered visitors have been reviewed. You are all caught up!</p>
      </div>

      <!-- Grid State -->
      <div v-else-if="pendingLayout === 'grid'" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
        <div v-for="visitor in filteredItems" :key="visitor.id" class="ae-card flex flex-col hover:shadow-lg hover:shadow-slate-200/50 dark:hover:shadow-black/50 transition-all group overflow-hidden border-2 border-transparent hover:border-indigo-500/20">
          <div class="p-5 flex-1 relative">
            <div class="flex items-start gap-4 relative z-10">
              <div class="w-16 h-16 rounded-2xl overflow-hidden bg-slate-100 dark:bg-slate-800 shrink-0 border-2 border-white dark:border-slate-700 shadow-sm">
                <img v-if="visitor.photo" :src="getPhotoUrl(visitor.photo)" class="w-full h-full object-cover" />
                <div v-else class="w-full h-full flex items-center justify-center text-2xl font-bold text-slate-400">
                  {{ visitor.personName?.charAt(0).toUpperCase() || '?' }}
                </div>
              </div>
              <div class="flex-1 min-w-0 pt-1">
                <h3 class="font-bold text-lg text-slate-900 dark:text-slate-100 truncate cursor-pointer hover:text-indigo-600 transition-colors" :title="visitor.personName" @click="viewVisitorCard(visitor)">
                  {{ visitor.personName }}
                </h3>
                <p class="text-sm font-medium text-slate-500 dark:text-slate-400 truncate flex items-center gap-1.5 mt-0.5">
                  <span class="w-1.5 h-1.5 rounded-full bg-slate-300 dark:bg-slate-600"></span>
                  {{ visitor.company || 'Personal Visit' }}
                </p>
                <div class="mt-3 inline-flex items-center gap-1.5 text-[10px] font-black uppercase tracking-widest px-2.5 py-1 bg-amber-50 dark:bg-amber-900/30 text-amber-600 dark:text-amber-500 rounded-md border border-amber-100 dark:border-amber-900/50">
                  Host: {{ visitor.personToMeet || 'N/A' }}
                </div>
              </div>
            </div>
            
            <div class="mt-6 grid grid-cols-2 gap-3 text-sm relative z-10">
              <div class="bg-slate-50 dark:bg-slate-800/50 rounded-xl p-3 border border-slate-100 dark:border-slate-800">
                <p class="text-[9px] font-black uppercase tracking-widest text-slate-400 mb-1">Contact</p>
                <p class="font-bold text-slate-700 dark:text-slate-200 truncate">{{ visitor.mobileNumber || visitor.email || '—' }}</p>
              </div>
              <div class="bg-slate-50 dark:bg-slate-800/50 rounded-xl p-3 border border-slate-100 dark:border-slate-800">
                <p class="text-[9px] font-black uppercase tracking-widest text-slate-400 mb-1">Visit Time</p>
                <p class="font-bold text-slate-700 dark:text-slate-200 truncate">{{ visitor.startTime?.slice(0, 5) || '—' }} - {{ visitor.endTime?.slice(0, 5) || '—' }}</p>
              </div>
            </div>
          </div>
          
          <div class="p-3 bg-slate-50/80 dark:bg-slate-800/80 border-t border-slate-100 dark:border-slate-700/50 flex gap-2">
            <button class="flex-1 py-3 px-4 rounded-xl font-bold text-sm bg-emerald-500 hover:bg-emerald-600 text-white transition-all flex items-center justify-center gap-2 shadow-sm shadow-emerald-500/20 active:scale-[0.98]" @click="quickAction(visitor)">
              <CheckCircle class="w-4 h-4" />
              Approve
            </button>
            <button class="px-4 py-3 rounded-xl font-bold text-sm bg-white dark:bg-slate-900 hover:bg-rose-50 text-slate-500 hover:text-rose-600 dark:text-slate-400 dark:hover:bg-rose-900/20 dark:hover:text-rose-400 border border-slate-200 dark:border-slate-700 transition-all flex items-center justify-center group" title="Deny Entry" @click="toggleBlock(visitor)">
              <ShieldOff class="w-4 h-4 group-hover:scale-110 transition-transform" />
            </button>
          </div>
        </div>
      </div>

      <!-- List State -->
      <div v-else-if="pendingLayout === 'list'" class="ae-card overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm whitespace-nowrap">
            <thead class="bg-slate-50 dark:bg-slate-800/50 text-[10px] uppercase font-semibold text-slate-400 tracking-wider">
              <tr>
                <th class="px-4 py-2">Visitor</th>
                <th class="px-4 py-2">Host</th>
                <th class="px-4 py-2">Company</th>
                <th class="px-4 py-2">Time</th>
                <th class="px-4 py-2 text-right">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 dark:divide-slate-700/50">
              <tr v-for="visitor in filteredItems" :key="visitor.id" class="hover:bg-slate-50 dark:hover:bg-slate-800/50 cursor-pointer transition-colors" @click="viewVisitorCard(visitor)">
                <td class="px-4 py-2">
                  <div class="flex items-center gap-2">
                    <div class="w-6 h-6 rounded bg-indigo-100 dark:bg-indigo-900/30 flex items-center justify-center shrink-0">
                      <img v-if="visitor.photo" :src="getPhotoUrl(visitor.photo)" class="w-full h-full object-cover rounded" />
                      <span v-else class="text-[10px] font-bold text-indigo-700 dark:text-indigo-400">{{ visitor.personName?.charAt(0).toUpperCase() || '?' }}</span>
                    </div>
                    <span class="font-semibold text-slate-900 dark:text-slate-100 truncate max-w-[150px]">{{ visitor.personName }}</span>
                  </div>
                </td>
                <td class="px-4 py-2 text-slate-600 dark:text-slate-300 truncate max-w-[120px]">{{ visitor.personToMeet || '—' }}</td>
                <td class="px-4 py-2 text-slate-600 dark:text-slate-300 truncate max-w-[120px]">{{ visitor.company || '—' }}</td>
                <td class="px-4 py-2 text-slate-600 dark:text-slate-300">{{ visitor.startTime?.slice(0, 5) || '—' }} - {{ visitor.endTime?.slice(0, 5) || '—' }}</td>
                <td class="px-4 py-2">
                  <div class="flex justify-end gap-1" @click.stop>
                    <button class="p-1.5 rounded text-emerald-600 hover:bg-emerald-50 dark:text-emerald-500 dark:hover:bg-emerald-500/10 transition-colors" title="Approve" @click="quickAction(visitor)">
                      <CheckCircle class="w-4 h-4" />
                    </button>
                    <button class="p-1.5 rounded text-rose-500 hover:bg-rose-50 dark:text-rose-500 dark:hover:bg-rose-500/10 transition-colors" title="Deny" @click="toggleBlock(visitor)">
                      <ShieldOff class="w-4 h-4" />
                    </button>
                  </div>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
      </div>

    <!-- Registration Modal -->
    <Teleport to="body">
      <transition name="fade">
        <div
          v-if="showAddModal"
          class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/40 backdrop-blur-sm"
        >
          <div class="relative w-full max-w-md ae-card shadow-xl overflow-hidden animate-in flex flex-col max-h-[90vh]">
            <!-- Header -->
            <div class="flex items-center justify-between p-5 border-b border-slate-100 dark:border-slate-700">
              <div class="flex items-center gap-2">
                <div class="w-8 h-8 rounded-lg bg-indigo-50 flex items-center justify-center">
                  <UserPlus class="w-4 h-4 text-indigo-600" />
                </div>
                <h3 class="text-sm font-bold text-slate-900 dark:text-slate-100">
                  Pre-Register Visitor
                </h3>
              </div>
              <button
                class="btn-icon"
                @click="showAddModal = false"
              >
                <X class="w-4 h-4" />
              </button>
            </div>

            <!-- Form -->
            <div class="p-5 space-y-4 overflow-y-auto custom-scrollbar">
              <div class="space-y-1.5">
                <label class="ae-section-label">Full Name <span class="text-rose-500">*</span></label>
                <input
                  v-model="form.personName"
                  type="text"
                  placeholder="John Doe"
                  class="ae-input"
                  :class="{'border-rose-500 bg-rose-50/30 dark:bg-rose-900/10': formErrors.personName}"
                  @input="formErrors.personName = null"
                >
                <p v-if="formErrors.personName" class="text-[10px] text-rose-500 font-medium mt-1">{{ formErrors.personName }}</p>
              </div>

              <div class="grid grid-cols-2 gap-3">
                <div class="space-y-1.5">
                  <label class="ae-section-label">Mobile <span class="text-rose-500">*</span></label>
                  <input
                    v-model="form.mobileNumber"
                    type="text"
                    inputmode="numeric"
                    maxlength="10"
                    placeholder="10-digit"
                    class="ae-input"
                    :class="{'border-rose-500 bg-rose-50/30 dark:bg-rose-900/10': formErrors.mobileNumber}"
                    @input="form.mobileNumber = $event.target.value.replace(/\D/g, ''); formErrors.mobileNumber = null"
                  >
                  <p v-if="formErrors.mobileNumber" class="text-[10px] text-rose-500 font-medium mt-1">{{ formErrors.mobileNumber }}</p>
                </div>
                <div class="space-y-1.5">
                  <label class="ae-section-label">Email</label>
                  <input
                    v-model="form.email"
                    type="email"
                    placeholder="john@example.com"
                    class="ae-input"
                  >
                </div>
              </div>

              <div class="grid grid-cols-2 gap-3">
                <div class="space-y-1.5">
                  <label class="ae-section-label">Start Date</label>
                  <input
                    v-model="form.startDate"
                    type="date"
                    class="ae-input"
                  >
                </div>
                <div class="space-y-1.5">
                  <label class="ae-section-label">End Date</label>
                  <input
                    v-model="form.endDate"
                    type="date"
                    class="ae-input"
                  >
                </div>
              </div>

              <div class="grid grid-cols-2 gap-3">
                <div class="space-y-1.5">
                  <label class="ae-section-label">Start Time</label>
                  <input
                    v-model="form.startTime"
                    type="time"
                    class="ae-input"
                  >
                </div>
                <div class="space-y-1.5">
                  <label class="ae-section-label">End Time</label>
                  <input
                    v-model="form.endTime"
                    type="time"
                    class="ae-input"
                  >
                </div>
              </div>

              <div class="grid grid-cols-2 gap-3">
                <div class="space-y-1.5">
                  <label class="ae-section-label">Person to Meet</label>
                  <input
                    v-model="form.personToMeet"
                    type="text"
                    placeholder="Host name or department"
                    class="ae-input"
                  >
                </div>
                <div class="space-y-1.5">
                  <label class="ae-section-label">Reason for Visit <span class="text-rose-500">*</span></label>
                  <input
                    v-model="form.reasonForVisit"
                    type="text"
                    placeholder="e.g. Meeting, Interview"
                    class="ae-input"
                    :class="{'border-rose-500 bg-rose-50/30 dark:bg-rose-900/10': formErrors.reasonForVisit}"
                    @input="formErrors.reasonForVisit = null"
                  >
                  <p v-if="formErrors.reasonForVisit" class="text-[10px] text-rose-500 font-medium mt-1">{{ formErrors.reasonForVisit }}</p>
                </div>
              </div>

              <div class="space-y-1.5">
                <label class="ae-section-label">Access Level (Optional)</label>
                <select
                  v-model="form.assignedAccessLevels"
                  class="ae-select"
                >
                  <option value="">
                    None
                  </option>
                  <option
                    v-for="lvl in accessLevels"
                    :key="lvl.id"
                    :value="lvl.id"
                  >
                    {{ lvl.accessLevelName }}
                  </option>
                </select>
              </div>
            </div>

            <!-- Footer -->
            <div class="p-5 border-t border-slate-100 dark:border-slate-700 flex justify-end gap-2">
              <button
                class="btn-ghost"
                @click="showAddModal = false"
              >
                Cancel
              </button>
              <button
                :disabled="saving"
                class="btn-primary"
                @click="submitVisitor"
              >
                <Loader2
                  v-if="saving"
                  class="w-4 h-4 animate-spin"
                />
                <UserPlus
                  v-else
                  class="w-4 h-4"
                />
                Register
              </button>
            </div>
          </div>
        </div>
      </transition>
    </Teleport>



    <!-- Registration Links Tab -->
    <div
      v-if="activeTab === 'portals'"
      class="flex-1 flex flex-col overflow-hidden animate-in"
    >
      <VisitorPortals
        embedded
        class="flex-1 shadow-none border border-slate-200 dark:border-slate-800/50 rounded-xl"
      />
    </div>

    <!-- ID Card Modal -->
    <VisitorPassModal
      :show="showIdCardModal"
      :visitor="selectedVisitorForCard"
      @close="handleModalClose"
      @quickAction="quickAction"
    />

    <!-- QR Scanner Modal -->
    <QRScanModal
      :show="showQrModal"
      @close="showQrModal = false"
      @scan="handleQrScan"
    />
    <!-- Confirm Action Modal -->
    <div
      v-if="confirmModal.show"
      class="fixed inset-0 z-[100] flex items-center justify-center p-4 sm:p-6 animate-in fade-in duration-200"
    >
      <div class="absolute inset-0 bg-slate-900/60 backdrop-blur-sm" @click="!confirmModal.loading && (confirmModal.show = false)" />
      
      <div class="relative bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl w-full max-w-sm overflow-hidden shadow-2xl animate-in zoom-in-95 duration-200">
        <div class="p-5 border-b border-slate-100 dark:border-slate-800 flex justify-between items-center bg-slate-50/50 dark:bg-slate-800/30">
          <h3 class="font-bold text-slate-800 dark:text-slate-200">{{ confirmModal.title }}</h3>
          <button
            class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-300 transition-colors"
            @click="!confirmModal.loading && (confirmModal.show = false)"
            :disabled="confirmModal.loading"
          >
            <X class="w-5 h-5" />
          </button>
        </div>
        
        <div class="p-6">
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            {{ confirmModal.message }}
          </p>
        </div>
        
        <div class="p-5 bg-slate-50/50 dark:bg-slate-800/30 border-t border-slate-100 dark:border-slate-800 flex justify-end gap-3">
          <button
            class="px-4 py-2 text-sm font-semibold text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 rounded-lg transition-colors"
            @click="confirmModal.show = false"
            :disabled="confirmModal.loading"
          >
            Cancel
          </button>
          <button
            class="px-4 py-2 text-sm font-semibold text-white bg-indigo-600 hover:bg-indigo-700 rounded-lg transition-colors flex items-center gap-2 shadow-sm"
            @click="confirmModal.onConfirm"
            :disabled="confirmModal.loading"
          >
            <Loader2 v-if="confirmModal.loading" class="w-4 h-4 animate-spin" />
            Confirm
          </button>
        </div>
      </div>
  </div>
</template>

<script setup>
import { ref, computed, watch, onMounted, onUnmounted } from 'vue';
import {
  Users, Search, UserPlus, Loader2, X, FileDown, ArrowLeft,
  Eye, ShieldOff, ShieldCheck, LinkIcon, CheckCircle, Activity,
  BarChart3, Globe, QrCode, Clock, LogOut, LayoutGrid, List
} from 'lucide-vue-next';
import * as XLSX from 'xlsx';
import { authService } from '@/services/authService';
import { currentUserTenant } from '@/utils/currentUserTenant';
import VisitorPassModal from '@/components/common/modals/VisitorPassModal.vue';
import QRScanModal from '@/components/common/modals/QRScanModal.vue';

import VisitorPortals from '@/pages/visitorPortals/index.vue';
import { useRoute } from 'vue-router';

const route = useRoute();
const activeTab = ref(route.query.tab || 'analytics');
const pendingLayout = ref('grid');
watch(() => route.query.tab, (newTab) => {
  if (newTab) activeTab.value = newTab;
});

const pageTitle = computed(() => {
  if (activeTab.value === 'analytics') return 'Visitor Management';
  if (activeTab.value === 'portals') return 'Registration Portal';
  if (activeTab.value === 'pending') return 'Pending Approvals';
  return 'Visitor Management';
});

const pageSubtitle = computed(() => {
  if (activeTab.value === 'analytics') return 'Register, manage and track all visitors';
  if (activeTab.value === 'portals') return 'Create and manage self-registration portals for visitors';
  return 'Review and approve pending visitor requests';
});

const token = authService.getToken();
const apiUrl = import.meta.env.VITE_API_URL;

const getPhotoUrl = (photoId) => photoId ? `${apiUrl}/assets/${photoId}?access_token=${token}` : '';

// State
const loading = ref(true);
const saving = ref(false);
const items = ref([]);
const accessLevels = ref([]);
const searchQuery = ref('');
const validStatuses = ['all', 'active', 'inactive', 'blocked'];
const getValidStatus = (status) => {
  if (!status) return 'all';
  const normalized = status.toLowerCase();
  // Map old 'pending' URL param to 'inactive' automatically
  if (normalized === 'pending') return 'inactive';
  return validStatuses.includes(normalized) ? normalized : 'all';
};
const statusFilter = ref(getValidStatus(route.query.status));
watch(() => route.query.status, (newStatus) => {
  statusFilter.value = getValidStatus(newStatus);
});
const sortOrder = ref('newest'); // 'newest', 'oldest', 'nameAsc', 'nameDesc'
const dateFilter = ref('all'); // 'all', 'today', 'this_week', 'this_month'
const page = ref(1);
const limit = 15;
const totalItems = ref(0);
const totalPages = computed(() => Math.ceil(totalItems.value / limit));
const showAddModal = ref(false);
const showExportMenu = ref(false);
const showIdCardModal = ref(false);
const showQrModal = ref(false);
const confirmModal = ref({
  show: false,
  message: '',
  title: 'Confirm Action',
  onConfirm: null,
  loading: false
});
const selectedVisitorForCard = ref(null);

const handleQrScan = (data) => {
  // Try to parse if it's a URL or raw ID, for now we just show it
  alert('Successfully scanned visitor pass! ID: ' + data);
};
const linkCopied = ref(false);
const activePortal = ref(null);

watch(() => route.query.search, (newVal) => {
  if (newVal !== undefined) {
    searchQuery.value = newVal || '';
    page.value = 1;
    loadVisitors();
  }
}, { immediate: true });

const analyticsStats = ref({
  total: 0,
  today: 0,
  checkedIn: 0,
  checkedOut: 0,
  pending: 0,
  blocked: 0
});

const loadAnalytics = async () => {
  const tenantId = await currentUserTenant.getTenantIdAsync();
  if (!tenantId || !token) return;

  const todayStr = new Date().toISOString().split('T')[0];

  const fetchCount = async (filters) => {
    const params = new URLSearchParams({
      limit: '0',
      meta: 'filter_count',
      'filter[tenant][tenantId][_eq]': tenantId,
      ...filters
    });
    const res = await fetch(`${apiUrl}/items/visitor?${params}`, { headers: { Authorization: `Bearer ${token}` } });
    if (res.ok) {
      const d = await res.json();
      return d.meta?.filter_count ?? 0;
    }
    return 0;
  };

  try {
    const [totalCount, todayCount, checkedInCount, checkedOutCount, pendingCount, blockedCount] = await Promise.all([
      fetchCount({}), // empty filters = total for tenant
      fetchCount({ 'filter[date_created][_gte]': `${todayStr}T00:00:00` }),
      fetchCount({ 'filter[status][_eq]': 'active' }),
      fetchCount({ 'filter[status][_eq]': 'checked_out' }),
      fetchCount({ 'filter[status][_eq]': 'inactive' }),
      fetchCount({ 'filter[status][_eq]': 'blocked' })
    ]);
    
    analyticsStats.value = {
      total: totalCount,
      today: todayCount,
      checkedIn: checkedInCount,
      checkedOut: checkedOutCount,
      pending: pendingCount,
      blocked: blockedCount
    };
  } catch (e) {
    console.error("Failed to load analytics counts:", e);
  }
};

const filters = [
  { label: 'All', value: 'all' },
  { label: 'Active', value: 'active' },
  { label: 'Pending', value: 'inactive' },
  { label: 'Blocked', value: 'blocked' },
];

const sortItems = (arr) => {
  return [...arr].sort((a, b) => {
    switch (sortOrder.value) {
      case 'newest': return new Date(b.created_at || 0) - new Date(a.created_at || 0);
      case 'oldest': return new Date(a.created_at || 0) - new Date(b.created_at || 0);
      case 'nameAsc': return (a.personName || '').localeCompare(b.personName || '');
      case 'nameDesc': return (b.personName || '').localeCompare(a.personName || '');
      default: return 0;
    }
  });
};

const filteredItems = computed(() => {
  let res = items.value;
  if (activeTab.value === 'pending') {
    res = res.filter(v => v.status === 'inactive');
  } else if (statusFilter.value !== 'all') {
    res = res.filter(v => v.status === statusFilter.value);
  }
  
  if (dateFilter.value !== 'all') {
    const today = new Date();
    today.setHours(0,0,0,0);
    res = res.filter(v => {
      if (!v.created_at && !v.startDate) return false;
      const d = new Date(v.created_at || v.startDate);
      if (dateFilter.value === 'today') {
        const itemDate = new Date(d);
        itemDate.setHours(0,0,0,0);
        return itemDate.getTime() === today.getTime();
      }
      if (dateFilter.value === 'this_week') {
        const weekAgo = new Date(today);
        weekAgo.setDate(weekAgo.getDate() - 7);
        return d >= weekAgo;
      }
      if (dateFilter.value === 'this_month') {
        const monthAgo = new Date(today);
        monthAgo.setMonth(monthAgo.getMonth() - 1);
        return d >= monthAgo;
      }
      return true;
    });
  }
  
  return sortItems(res);
});

const today = new Date().toISOString().split('T')[0];
const form = ref({
  personName: '', mobileNumber: '', email: '',
  startDate: today, endDate: today,
  startTime: '09:00', endTime: '18:00',
  personToMeet: '', reasonForVisit: '', assignedAccessLevels: ''
});
const formErrors = ref({});

const viewVisitorCard = (visitor) => {
  selectedVisitorForCard.value = visitor;
  showIdCardModal.value = true;
};

const handleModalClose = () => {
  showIdCardModal.value = false;
  loadVisitors(); // Auto-refresh to get updated photos or status changes
};

// Debounced search
let searchTimeout;
const debouncedSearch = () => {
  clearTimeout(searchTimeout);
  searchTimeout = setTimeout(() => { page.value = 1; loadVisitors(); }, 400);
};

watch(page, () => loadVisitors());

const getStatusClass = (status) => {
  if (status === 'active') return 'badge-success';
  if (status === 'blocked') return 'badge-danger';
  return 'badge-warning';
};
const getStatusDot = (status) => {
  if (status === 'active') return 'bg-emerald-500';
  if (status === 'blocked') return 'bg-red-500';
  return 'bg-amber-500';
};
const getStatusLabel = (status) => {
  if (status === 'active') return 'Checked In';
  if (status === 'blocked') return 'Blocked';
  if (status === 'checked_out') return 'Checked Out';
  return 'Pending Approval';
};

const loadAccessLevels = async () => {
  const tenantId = await currentUserTenant.getTenantIdAsync();
  if (!tenantId || !token) return;
  try {
    const res = await fetch(`${apiUrl}/items/accesslevels?filter[tenant][tenantId][_eq]=${tenantId}&limit=100`, {
      headers: { Authorization: `Bearer ${token}` }
    });
    if (res.ok) { const d = await res.json(); accessLevels.value = d.data || []; }
  } catch (e) { console.error(e); }
};

const loadActivePortal = async () => {
  const tenantId = await currentUserTenant.getTenantIdAsync();
  if (!tenantId || !token) return;
  try {
    const res = await fetch(`${apiUrl}/items/BrandedPages?filter[tenant][_eq]=${tenantId}&limit=1&fields=id,Title`, {
      headers: { Authorization: `Bearer ${token}` }
    });
    if (res.ok) { const d = await res.json(); activePortal.value = d.data?.[0] || null; }
  } catch (e) { /* silent */ }
};

const copyPortalLink = async () => {
  if (!activePortal.value) return;
  const url = `${window.location.origin}/visit/${activePortal.value.id}`;
  try {
    await navigator.clipboard.writeText(url);
    linkCopied.value = true;
    setTimeout(() => { linkCopied.value = false; }, 3500);
  } catch (e) { alert(`Share this link: ${url}`); }
};

const loadVisitors = async () => {
  const tenantId = await currentUserTenant.getTenantIdAsync();
  if (!tenantId || !token) return;
  loading.value = true;
  try {
    const filter = { 'filter[tenant][tenantId][_eq]': tenantId };
    if (searchQuery.value) {
      filter['filter[_or][0][personName][_icontains]'] = searchQuery.value;
      filter['filter[_or][1][email][_icontains]'] = searchQuery.value;
      filter['filter[_or][2][mobileNumber][_icontains]'] = searchQuery.value;
    }
    const params = new URLSearchParams({
      limit: limit.toString(), page: page.value.toString(),
      sort: '-date_created',
      fields: 'id,personName,email,mobileNumber,startDate,endDate,startTime,endTime,status,assignedAccessLevels.accessLevelName,date_created,photo,personToMeet,reasonForVisit,company',
      meta: 'filter_count', ...filter
    });
    const res = await fetch(`${apiUrl}/items/visitor?${params}`, { headers: { Authorization: `Bearer ${token}` } });
    if (res.ok) { const d = await res.json(); items.value = d.data || []; totalItems.value = d.meta?.filter_count ?? 0; }
  } catch (e) { console.error(e); }
  finally { loading.value = false; }
};

// Block / Unblock
const toggleBlock = (visitor) => {
  const newStatus = visitor.status === 'blocked' ? 'inactive' : 'blocked';
  const isBlock = newStatus === 'blocked';
  confirmModal.value = {
    show: true,
    title: isBlock ? 'Block Visitor' : 'Unblock Visitor',
    message: isBlock 
      ? `Are you sure you want to block ${visitor.personName}? They will not be able to gain entry.`
      : `Are you sure you want to unblock ${visitor.personName}?`,
    onConfirm: async () => {
      confirmModal.value.loading = true;
      try {
        const res = await fetch(`${apiUrl}/items/visitor/${visitor.id}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
          body: JSON.stringify({ status: newStatus })
        });
        if (res.ok) {
          visitor.status = newStatus;
        }
      } catch (e) { console.error('Block/unblock failed', e); }
      confirmModal.value.show = false;
      confirmModal.value.loading = false;
    }
  };
};

// Quick Action: Approve / Check Out
const quickAction = (visitor) => {
  let newStatus;
  let confirmMsg;
  let title;
  if (visitor.status === 'inactive') {
    newStatus = 'active';
    title = 'Approve Visitor';
    confirmMsg = `Are you sure you want to approve and check in ${visitor.personName}?`;
  } else if (visitor.status === 'active') {
    newStatus = 'checked_out';
    title = 'Check Out Visitor';
    confirmMsg = `Are you sure you want to check out ${visitor.personName}?`;
  } else {
    return;
  }
  
  confirmModal.value = {
    show: true,
    title,
    message: confirmMsg,
    onConfirm: async () => {
      confirmModal.value.loading = true;
      try {
        const res = await fetch(`${apiUrl}/items/visitor/${visitor.id}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
          body: JSON.stringify({ status: newStatus })
        });
        if (res.ok) {
          visitor.status = newStatus;
          loadAnalytics();
          if (showIdCardModal.value) handleModalClose();
        }
      } catch (e) { console.error('Quick action failed', e); }
      confirmModal.value.show = false;
      confirmModal.value.loading = false;
    }
  };
};

const submitVisitor = async () => {
  const userTenant = await currentUserTenant.fetchLoginUserDetails();
  const tenantData = userTenant?.tenant;
  formErrors.value = {};
  let hasError = false;
  if (!form.value.personName) { formErrors.value.personName = 'Full Name is required'; hasError = true; }
  if (!form.value.mobileNumber) { formErrors.value.mobileNumber = 'Mobile Number is required'; hasError = true; }
  if (!form.value.reasonForVisit) { formErrors.value.reasonForVisit = 'Reason for Visit is required'; hasError = true; }
  if (form.value.mobileNumber && !/^\d{10}$/.test(form.value.mobileNumber)) { formErrors.value.mobileNumber = 'Must be exactly 10 digits'; hasError = true; }
  if (hasError || !tenantData || !token) return;
  saving.value = true;
  try {
    const payload = {
      personName: form.value.personName, email: form.value.email,
      mobileNumber: form.value.mobileNumber, startDate: form.value.startDate,
      endDate: form.value.endDate, startTime: form.value.startTime,
      endTime: form.value.endTime, personToMeet: form.value.personToMeet || null,
      reasonForVisit: form.value.reasonForVisit || null,
      assignedAccessLevels: form.value.assignedAccessLevels || null,
      status: 'inactive', tenant: tenantData, quantity: 1
    };
    const res = await fetch(`${apiUrl}/items/visitor`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
      body: JSON.stringify(payload)
    });
    if (res.ok) {
      form.value = { personName: '', mobileNumber: '', email: '', startDate: today, endDate: today, startTime: '09:00', endTime: '18:00', personToMeet: '', reasonForVisit: '', assignedAccessLevels: '' };
      showAddModal.value = false;
      page.value = 1;
      loadVisitors();
    }
  } catch (e) { console.error(e); }
  finally { saving.value = false; }
};

const formatDate = (iso) => {
  if (!iso) return '—';
  return new Date(iso).toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' });
};

// Export (unchanged logic)
const fetchAllVisitorsForExport = async () => {
  const tenantId = await currentUserTenant.getTenantIdAsync();
  if (!tenantId || !token) return [];
  try {
    const res = await fetch(`${apiUrl}/items/visitor?filter[tenant][tenantId][_eq]=${tenantId}&limit=-1&sort=-date_created&fields=personName,email,mobileNumber,startDate,endDate,startTime,endTime,status,assignedAccessLevels.accessLevelName,date_created`, {
      headers: { Authorization: `Bearer ${token}` }
    });
    if (res.ok) { const d = await res.json(); return d.data || []; }
  } catch (e) { console.error(e); }
  return [];
};

const exportVisitorsExcel = async () => {
  const exportItems = await fetchAllVisitorsForExport();
  if (!exportItems.length) { alert('No data to export'); return; }

  const rows = exportItems.map(item => ({
    'Name': item.personName || '',
    'Email': item.email || '',
    'Mobile': item.mobileNumber || '',
    'Start Date': item.startDate || '',
    'End Date': item.endDate || '',
    'Access Level': item.assignedAccessLevels?.accessLevelName || 'N/A',
    'Status': item.status || '',
    'Registered On': item.date_created ? item.date_created.split('T')[0] : '',
  }));

  const worksheet = XLSX.utils.json_to_sheet(rows);
  const workbook = XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(workbook, worksheet, 'Visitors');
  XLSX.writeFile(workbook, `Visitors_${today}.xlsx`);
};

const exportVisitorsCSV = async () => {
  const exportItems = await fetchAllVisitorsForExport();
  if (!exportItems.length) { alert('No data to export'); return; }
  const headers = ['Name', 'Email', 'Mobile', 'Start Date', 'End Date', 'Access Level', 'Status', 'Registered On'];
  const rows = exportItems.map(i => [
    `"${(i.personName || '').replace(/"/g, '""')}"`,
    `"${(i.email || '').replace(/"/g, '""')}"`,
    i.mobileNumber || '', i.startDate || '', i.endDate || '',
    `"${(i.assignedAccessLevels?.accessLevelName || 'N/A').replace(/"/g, '""')}"`,
    i.status || '',
    i.date_created ? i.date_created.split('T')[0] : ''
  ]);
  const csv = [headers.join(','), ...rows.map(r => r.join(','))].join('\n');
  const link = document.createElement('a');
  link.href = URL.createObjectURL(new Blob([csv], { type: 'text/csv;charset=utf-8;' }));
  link.download = `Visitors_${today}.csv`;
  document.body.appendChild(link);
  link.click();
  document.body.removeChild(link);
};

let refreshInterval;

onMounted(() => {
  loadVisitors();
  loadAnalytics();
  loadAccessLevels();
  loadActivePortal();
  
  // Background polling for real-time updates without showing loading spinner
  refreshInterval = setInterval(async () => {
    // Only poll if we are on the first page and not searching to avoid disrupting user workflow
    if (page.value === 1 && !searchQuery.value) {
      const tenantId = await currentUserTenant.getTenantIdAsync();
      if (!tenantId || !token) return;
      
      try {
        const filter = { 'filter[tenant][tenantId][_eq]': tenantId };
        const params = new URLSearchParams({
          limit: limit.toString(), page: page.value.toString(),
          sort: '-date_created',
          fields: 'id,personName,email,mobileNumber,startDate,endDate,startTime,endTime,status,assignedAccessLevels.accessLevelName,date_created,photo,personToMeet,reasonForVisit,company',
          meta: 'filter_count', ...filter
        });
        const res = await fetch(`${apiUrl}/items/visitor?${params}`, { headers: { Authorization: `Bearer ${token}` } });
        if (res.ok) { 
          const d = await res.json(); 
          items.value = d.data || []; 
          totalItems.value = d.meta?.filter_count ?? 0; 
        }
        
        // Refresh analytics stats silently too
        loadAnalytics();
      } catch (e) {
        // silent fetch error during polling
      }
    }
  }, 5000);
});

onUnmounted(() => {
  if (refreshInterval) clearInterval(refreshInterval);
});
</script>

<style scoped>
.fade-enter-active, .fade-leave-active { transition: opacity 0.3s; }
.fade-enter-from, .fade-leave-to { opacity: 0; }
</style>
