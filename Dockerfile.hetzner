# Build stage — Hetzner deployment
FROM node:18 as build-stage

WORKDIR /build

COPY package*.json ./
RUN npm install

COPY . .

# Hetzner backend env vars (baked at build time)
ARG VITE_API_URL
ARG VITE_API_TOKEN
ARG VITE_KN_API_URL
ARG VITE_UI_URL
ARG VITE_GOOGLE_MAPS_API_KEY

ENV VITE_API_URL=${VITE_API_URL}
ENV VITE_API_TOKEN=${VITE_API_TOKEN}
ENV VITE_KN_API_URL=${VITE_KN_API_URL}
ENV VITE_UI_URL=${VITE_UI_URL}
ENV VITE_GOOGLE_MAPS_API_KEY=${VITE_GOOGLE_MAPS_API_KEY}

RUN NODE_OPTIONS="--max-old-space-size=4096" npm run build
RUN NODE_OPTIONS="--max-old-space-size=4096" npm run build:security
RUN NODE_OPTIONS="--max-old-space-size=4096" npm run build:workforce
# Production stage
FROM nginx:stable-alpine as production-stage

COPY --from=build-stage /build/dist /usr/share/nginx/html
COPY nginx.conf.hetzner /etc/nginx/conf.d/default.conf

EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
